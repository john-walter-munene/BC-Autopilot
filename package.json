{
  "name": "bc-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous Dynamics 365 Business Central engineering agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run lint && npm run build -w @bc-agent/web",
    "dev": "npm run dev -w @bc-agent/web",
    "dev:api": "npm run dev -w @bc-agent/api",
    "start": "npm run start -w @bc-agent/api",
    "clean": "rimraf dist apps/api/dist apps/web/dist packages/shared/dist test-results",
    "cli": "node --experimental-strip-types bin/bc-agent.ts",
    "compile": "node --experimental-strip-types bin/bc-agent.ts compile",
    "symbols": "node --experimental-strip-types bin/bc-agent.ts symbols",
    "publish": "node --experimental-strip-types bin/bc-agent.ts publish",
    "sandbox": "node --experimental-strip-types bin/bc-agent.ts sandbox",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "npm run test:shared && npm run test:api && npm run test:cli",
    "test:shared": "node --experimental-strip-types --test \"packages/shared/src/*.test.ts\"",
    "test:api": "node --experimental-strip-types --test \"apps/api/src/**/*.test.ts\"",
    "test:cli": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:e2e:browser": "playwright test --config tests/playwright/playwright.config.ts",
    "verify": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}