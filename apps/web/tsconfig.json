{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@bc-agent/shared": ["../../packages/shared/src/index.ts"],
      "@bc-agent/api/*": ["../api/src/*"]
